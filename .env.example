# Srote — environment variables.
# Copy this file to .env (which is gitignored) and fill in real values.
# settings.py auto-loads .env at startup.

# ---- Telegram low-stock alerts (optional) ----
# 1. Talk to @BotFather → /newbot → save token
# 2. Send /start to your new bot, then:
#      curl https://api.telegram.org/bot<TOKEN>/getUpdates
#    Look for "chat":{"id": ...}
# 3. Paste below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Multiple chats? Comma-separated:
# TELEGRAM_CHAT_IDS=123456789,-1009876543210
